    {
      "unresolved": false,
      "key": {
        "uuid": "5cce1f3e_fda7d9ef",
        "filename": "CMakeLists.txt",
        "patchSetId": 4
      },
      "lineNbr": 238,
      "author": {
        "id": 1115898
      },
      "writtenOn": "2026-09-25T18:37:37Z",
      "side": 1,
      "message": "Because yuvconstants links against ${ly_lib_static} (libyuv.a), which is compiled from C++ sources, CMake promotes yuvconstants\u0027s LINKER_LANGUAGE to CXX and invokes CMAKE_CXX_COMPILER as the linker driver. On Linux, C++ compiler drivers (g++ and clang++) implicitly pass -lstdc++ -lm to ld, whereas C compiler drivers (gcc and clang) do not pass -lm implicitly. Keeping target_link_libraries(yuvconstants m) makes the libm dependency for round() explicit.",
      "parentUuid": "bb922999_03bd3592",
      "isAi": true,
      "revId": "14ebd47e3f0fc54375a65c12bc5a76b9633074ce",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
