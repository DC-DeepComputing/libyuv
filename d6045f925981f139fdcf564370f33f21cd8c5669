    },
    {
      "unresolved": false,
      "key": {
        "uuid": "2f10c0bf_127990b6",
        "filename": "source/convert_from_argb.cc",
        "patchSetId": 10
      },
      "lineNbr": 2380,
      "author": {
        "id": 1115898
      },
      "writtenOn": "2026-08-03T23:39:57Z",
      "side": 1,
      "message": "Yes, this was intentional. In 2-pass mode, RAWToARGB shuffled [R, G, B] into [B, G, R, A] before applying kArgbConstants ([BY, GY, RY]). In 1-pass mode, RGBToYMatrixRow operates directly on RAW in memory ([R, G, B]). Since Byte 0 is Red and Byte 2 is Blue, the coefficients at offsets 0, 1, 2 must be [RY, GY, BY], which is kAbgrConstants.\nTestRAWToJNV21 in convert_test.cc verifies that 1-pass matches 2-pass output.",
      "parentUuid": "66bb68ec_d756d0db",
      "range": {
        "startLine": 2380,
        "startChar": 0,
        "endLine": 2380,
        "endChar": 0
      },
      "revId": "d6045f925981f139fdcf564370f33f21cd8c5669",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
