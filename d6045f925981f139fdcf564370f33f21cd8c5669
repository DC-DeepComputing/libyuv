      "writtenOn": "2026-08-03T23:19:41Z",
      "side": 1,
      "message": "You changed the constant from kArgbJPEGConstants to kAbgrJPEGConstants. Was this intentional? Usually RAW (RGB24 big endian) mapping to YUV uses the same coefficients as ARGB (which is BGRA in memory).",
      "range": {
        "startLine": 2380,
        "startChar": 0,
        "endLine": 2380,
        "endChar": 0
      },
      "revId": "d6045f925981f139fdcf564370f33f21cd8c5669",
