agentic_review {
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:c|cc|cpp|h|hpp)"
    rules: "agents/knowledge_base/rules/general/clarify-nonobvious-function-parameters.md"
    rules: "agents/knowledge_base/rules/general/parenthesize-macro-parameters.md"
  }
  capability_groups {
    rules: "agents/knowledge_base/rules/general/document-secondary-changes-in-commit-description.md"
  }
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:gn|gni)"
    rules: "agents/knowledge_base/rules/general/no-defines-on-gn-group-targets.md"
  }
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:c|cc|cpp|h)"
    rules: "agents/knowledge_base/rules/general/prefer-named-constants-over-magic-numbers.md"
    rules: "agents/knowledge_base/rules/general/synchronize-endif-comment-with-condition.md"
  }
}
