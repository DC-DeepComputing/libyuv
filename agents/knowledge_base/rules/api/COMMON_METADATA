  }
  capability_groups {
    path_expression: "include/libyuv/cpu_id\\.h"
    path_expression: "source/cpu_id\\.cc"
    rules: "agents/knowledge_base/rules/api/guard-architecture-headers-with-cpu-preprocessor-checks.md"
    rules: "agents/knowledge_base/rules/api/no-implicit-init-flag-in-cpu-setters.md"
  }
  capability_groups {
    path_expression: "include/libyuv/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    path_expression: "source/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    path_expression: "unit_test/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    path_expression: "util/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
