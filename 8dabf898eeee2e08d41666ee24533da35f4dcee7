      "writtenOn": "2026-10-15T04:05:30Z",
      "side": 1,
      "message": "without looking at the code, i recall it implements (x-1) / (y-1).  so yes?",
      "parentUuid": "b7ceb797_58aa9f11",
      "revId": "8dabf898eeee2e08d41666ee24533da35f4dcee7",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
